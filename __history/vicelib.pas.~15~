unit vicelib;

interface

uses
    Winapi.Windows,
    Winapi.Messages;

  type
    TwindowHandle = HWND;

  procedure pixel(size: integer);
  procedure catch(code: integer; fatal: bool);
  procedure handle();
  procedure window(ATitle: PChar; AWidith, AHeight: Integer);

implementation

  procedure pixel(size: integer);
  begin
    if size = 1 then
      write('u')
    else if size = 2 then
    begin
      write('un')
    end
    else
    begin
      catch(1030, true);
    end;
  end;

  procedure catch(code: integer; fatal: bool);
  begin
    writeln(' Oops! Theres a error... OnO');
    write('Error code: Cx'); write(code);
    if fatal then
    begin
      readln;
      Halt;
    end;
  end;

  procedure handle();
  begin
    readln;
  end;

  function WindowProc(hWnd: HWND; Msg: UINT; wParam: WPARAM; lParam: LPARAM): LRESULT; stdcall;
  begin
    case Msg of
      WM_DESTROY:
        begin
          PostQuitMessage(0);
          Result := 0;
          Exit;
        end;
    end;

    Result := DefWindowProc(hWnd, Msg, wParam, lParam);
  end;

  procedure window(ATitle: PChar; AWidith, AHeight: Integer);
  var
    wc: WNDCLASSEX;
    msg: MSG;
  begin

  end;

end.
